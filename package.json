{
  "name": "headless",
  "type": "module",
  "private": true,
  "engines": {
    "node": "20.x"
  },
  "scripts": {
    "assets": "npm run images && npm run fonts && npm run media && npm run video",
    "build": "nuxt build",
    "dev": "nuxt dev",
    "dev:clean": "pkill -f \"[n]uxt dev\" || true; rm -rf .nuxt node_modules/.cache/nuxt; nuxt dev",
    "fonts": "bash scripts/subset-fonts.sh",
    "generate": "node scripts/verify-catalogue.mjs && nuxt generate && node scripts/verify-build.mjs",
    "images": "node scripts/optimize-images.mjs",
    "lint": "eslint .",
    "media": "node scripts/fetch-media.mjs",
    "postinstall": "nuxt prepare",
    "preview": "nuxt preview",
    "test": "vitest run",
    "test:e2e": "PLAYWRIGHT_BROWSERS_PATH=$HOME/Library/Caches/ms-playwright playwright test",
    "test:watch": "vitest",
    "verify": "npm run lint && npm run verify:catalogue && npm run test",
    "verify:assets": "shasum -a 256 -c assets-source.sha256",
    "verify:catalogue": "node scripts/verify-catalogue.mjs",
    "verify:code": "node scripts/analyse-code.mjs",
    "video": "bash scripts/optimize-video.sh"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.2.2",
    "lenis": "^1.3.23",
    "nuxt": "^4.4.2",
    "vue": "^3.5.32",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.4.11",
    "eslint": "^10.8.1",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.10.0",
    "happy-dom": "^20.11.2",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.2.2",
    "vitest": "^4.1.10"
  }
}
